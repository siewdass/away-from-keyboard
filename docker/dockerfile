FROM --platform=linux/amd64 ubuntu:22.04

# Evitar prompts interactivos
ENV DEBIAN_FRONTEND=noninteractive

# Instalación de dependencias críticas (Librerías X11, OpenGL y Qt)
RUN apt-get update && apt-get install -y \
    wget \
    tar \
    xvfb \
    libopengl0 \
    libglx0 \
    libgl1-mesa-glx \
    libglapi-mesa \
    libosmesa6 \
    libgl1-mesa-dri \
    libegl1-mesa \
    libgles2-mesa \
    libqt5gui5 \
    libx11-6 \
    libx11-xcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-util1 \
    libxcb-cursor0 \
    libxcb-xinerama0 \
    libxcb-xinput0 \
    libxcb-shape0 \
    libxkbcommon-x11-0 \
    libfontconfig1 \
    libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

# Variables de entorno para forzar renderizado por software (Crucial para M4)
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV GALLIUM_DRIVER=swrast
ENV QT_X11_NO_MITSHM=1

WORKDIR /tibia_app